{
  "name": "examforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode preview",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pipeline": "python tools/ingestion/smoke_pipeline.py",
    "ingest:extract": "python tools/ingestion/extract_pdf.py",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply examforge-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply examforge-db --remote",
    "cf:types": "wrangler types",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:dry:preview": "npm run build:preview && wrangler deploy --dry-run",
    "deploy:preview": "npm run build:preview && wrangler deploy",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.6",
    "@fontsource/atkinson-hyperlegible": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@hono/zod-validator": "^0.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.8",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "8.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  },
  "overrides": {
    "minimatch": "10.2.6"
  }
}
